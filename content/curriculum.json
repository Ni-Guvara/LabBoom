  "labs": [
    { "id": "L1", "name": "测量直线运动的瞬时速度", "chapter": "M2", "type": "group",
      "category": "mechanics", "steps": ["装配","测量","结论"],
      "variables": ["纸带点数","时间间隔"], "formula": "v = Δx/Δt",
      "goal": "用打点计时器纸带计算瞬时速度，绘制 v-t 图像",
      "examPoints": ["瞬时速度的测量","v-t 图像"] },
    { "id": "L2", "name": "探究弹簧弹力与形变量的关系", "chapter": "M3", "type": "group",
      "category": "mechanics", "steps": ["装配","测量","结论"],
      "variables": ["挂钩码数","弹簧劲度系数"], "formula": "F = kx",
      "goal": "测 6 组 F-x 数据，拟合斜率得劲度系数 k，验证胡克定律",
      "examPoints": ["胡克定律","F-x 图像斜率","弹簧劲度系数"] },
    { "id": "L3", "name": "探究互成角度的力的合成", "chapter": "M3", "type": "group",
      "category": "mechanics", "steps": ["装配","测量","结论"],
      "variables": ["分力F1","分力F2","夹角θ"], "formula": "F = √(F1²+F2²+2F1F2cosθ)",
      "goal": "验证平行四边形定则：两分力合成的合力与直接测得的合力一致",
      "examPoints": ["力的平行四边形定则","合力与分力"] },
    { "id": "L4", "name": "探究加速度与力、质量的关系", "chapter": "M4", "type": "group",
      "category": "mechanics", "steps": ["装配","测量","结论"],
      "variables": ["沙桶质量m0","小车质量M","摩擦补偿开关"], "formula": "a = F/M, F≈m0g",
      "goal": "保持 M 改 m0 测 a-F；保持 F 改 M 测 a-1/M；拟合验证 a∝F、a∝1/M",
      "examPoints": ["牛顿第二定律","控制变量法","a-F/a-1/M 图像"] },
    { "id": "L5", "name": "探究平抛运动的特点", "chapter": "M5", "type": "group",
      "category": "mechanics", "steps": ["装配","测量","结论"],
      "variables": ["初速度v0","下落高度h"], "formula": "x = v0t, y = ½gt²",
      "goal": "用频闪留痕读出水平匀速、竖直匀加速，验证平抛分运动独立",
      "examPoints": ["平抛运动","运动的合成与分解"] },
    { "id": "L6", "name": "探究向心力与半径等的关系", "chapter": "M6", "type": "group",
      "category": "mechanics", "steps": ["装配","测量","结论"],
      "variables": ["质量m","角速度ω","半径r"], "formula": "F = mω²r",
      "goal": "用向心力演示器验证 F 与 m、ω²、r 的正比关系",
      "examPoints": ["向心力公式","向心加速度"] },
    { "id": "L7", "name": "验证机械能守恒定律", "chapter": "M8", "type": "group",
      "category": "mechanics", "steps": ["装配","测量","结论"],
      "variables": ["下落高度h"], "formula": "½mv² = mgh",
      "goal": "用自由落体纸带验证动能增加量等于重力势能减少量",
      "examPoints": ["机械能守恒","自由落体"] },
    { "id": "L8", "name": "观察电容器充放电", "chapter": "M10", "type": "group",
      "category": "electromagnetism", "steps": ["装配","测量","结论"],
      "variables": ["电容C","电阻R","充放电模式"], "formula": "i = I0·e^(-t/RC)",
      "goal": "观察 RC 电路充放电 i-t 曲线，理解时间常数 RC",
      "examPoints": ["电容充放电","时间常数"] },
    { "id": "L9", "name": "长度的测量及测量工具选用", "chapter": "M11", "type": "group",
      "category": "electromagnetism", "steps": ["装配","测量","结论"],
      "variables": ["游标格数","测微器读数"], "formula": "L = 主尺 + 游标×精度",
      "goal": "用 3D 游标卡尺与螺旋测微器读数，误差 ≤ 最小分度",
      "examPoints": ["游标卡尺读数","螺旋测微器读数"] },
    { "id": "L10", "name": "金属丝电阻率的测量", "chapter": "M11", "type": "group",
      "category": "electromagnetism", "steps": ["装配","测量","结论"],
      "variables": ["直径d","长度L","电压U","电流I"], "formula": "ρ = RS/L, R = U/I",
      "goal": "测 d、L、U、I 计算 ρ，含微观电子漂移双视图",
      "examPoints": ["电阻率","伏安法测电阻"] },
    { "id": "L11", "name": "练习使用多用电表", "chapter": "M11", "type": "group",
      "category": "electromagnetism", "steps": ["装配","测量","结论"],
      "variables": ["挡位","量程"], "formula": "—",
      "goal": "3D 旋钮选挡，测电压/电流/电阻，超量程打表",
      "examPoints": ["多用电表读数","挡位选择"] },
    { "id": "L12", "name": "测量电池电动势和内阻", "chapter": "M12", "type": "group",
      "category": "electromagnetism", "steps": ["装配","测量","结论"],
      "variables": ["外电阻R","电动势E","内阻r"], "formula": "E = U + Ir",
      "goal": "测 U-I 数据拟合直线，截距得 E、斜率得 r",
      "examPoints": ["闭合电路欧姆定律","U-I 图像求 E、r"] }
  ],
